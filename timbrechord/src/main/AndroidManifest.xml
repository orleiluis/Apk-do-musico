<?xml version="1.0" encoding="utf-8"?>
<!--
  Timbre Chord (github.com/orleiluis/timbre-chord) como módulo do Apk do Músico.
  Abre pelo menu "Timbre" do app; não tem ícone próprio na tela inicial.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- A separação de faixas precisa de bastante memória. -->
    <application android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/tc_app_name"
            android:launchMode="singleTask"
            android:theme="@style/TcTheme"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter android:label="@string/tc_app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter android:label="@string/tc_app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
        <service
            android:name=".SeparationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
